<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#054442"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4-7-8 Breathing"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Follow the timer at a comfortable pace. Stop if you feel uncomfortable or light-headed."
        android:textAlignment="center"
        android:textColor="#B2DFDB"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvBreathingRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="4 guided rounds"
        android:textColor="#B2DFDB"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="24dp">

        <View
            android:id="@+id/breathingCircle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_breathing_circle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBreathingPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#003D35"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBreathingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#003D35"
                android:textSize="42sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <Button
        android:id="@+id/btnStartBreathing"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="26dp"
        android:backgroundTint="#00796B"
        android:text="Start"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>